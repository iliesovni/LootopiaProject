@host = http://localhost:3000
@partnerId = c666224e-8386-4e90-9da3-556ec4cc5348
@huntId = 2664134f-1689-4df6-9540-1163cb7b5b64
@stepId = 9c0cddaf-2964-4593-a9b7-616362765e0f
@clueId = a046253f-4513-462a-9ef0-cb2452af315a

# @name TEST DB
GET {{host}}/api/test-db
Accept: application/json

###
# @name HUNTS_GET_ALL
GET {{host}}/api/hunts
Accept: application/json

###
# @name HUNTS - GET ONE
GET {{host}}/api/hunts/{{huntId}}
Accept: application/json

###
# @name HUNTS - POST
POST {{host}}/api/hunts
Content-Type: application/json

{
  "title": "Mystère au Parc Borély",
  "description": "Une chasse au trésor familiale dans le parc Borély.",
  "location": "Marseille",
  "difficulty": "EASY",
  "isPublic": true,
  "startLat": 43.2699,
  "startLng": 5.3878,
  "createdById": "{{partnerId}}"
}

###
# @name HUNTS - PATCH
PATCH {{host}}/api/hunts/{{huntId}}
Content-Type: application/json

{
  "title": "Chasse mise à jour",
  "difficulty": "HARD"
}

###
# @name HUNTS - DELETE
DELETE {{host}}/api/hunts/{{huntId}}

###
# @name STEPS - GET ALL
GET {{host}}/api/steps
Accept: application/json

###
# @name STEPS - GET ONE
GET {{host}}/api/steps/{{stepId}}
Accept: application/json

###
# @name STEPS - POST
POST {{host}}/api/hunts/{{huntId}}/steps
Content-Type: application/json

{
  "title": "Le kiosque",
  "description": "Trouve le kiosque central du parc.",
  "latitude": 43.2705,
  "longitude": 5.3882,
  "radiusMeters": 25,
  "orderIndex": 3,
  "pointsReward": 60,
  "arMarkerType": "IMAGE",
  "arAssetUrl": "https://example.com/ar/kiosque.png"
}

###
# @name STEPS - PATCH
PATCH {{host}}/api/steps/{{stepId}}
Content-Type: application/json

{
  "title": "Le kiosque rénové",
  "pointsReward": 80
}

###
# @name STEPS - DELETE
DELETE {{host}}/api/steps/{{stepId}}

###
# @name CLUES - GET ALL
GET {{host}}/api/clues
Accept: application/json

###
# @name CLUES - GET ONE
GET {{host}}/api/clues/{{clueId}}
Accept: application/json

###
# @name CLUES - POST
POST {{host}}/api/steps/{{stepId}}/clues
Content-Type: application/json

{
  "content": "Cherche près de la structure ronde au centre.",
  "penaltyPoints": 5,
  "orderIndex": 2
}

###
# @name CLUES - PATCH
PATCH {{host}}/api/clues/{{clueId}}
Content-Type: application/json

{
  "content": "Cherche près de la structure ronde et verte.",
  "penaltyPoints": 3
}

###
# @name CLUES - DELETE
DELETE {{host}}/api/clues/{{clueId}}

###
# @name PARTICIPATION - TEST
POST http://localhost:3000/api/participations/2f436eed-9da8-498d-83d3-f71760e8a993/complete-step
Content-Type: application/json

{
  "stepId": "705c4eb9-ee5b-4d08-871f-fbeb0ba635db"
}