{
  "name": "lootopia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:format": "npx prisma format",
    "db:validate": "npx prisma validate",
    "db:apply": "npm run db:format && npm run db:validate",
    "db:migrate": "npx prisma migrate dev --name",
    "db:generate": "npx prisma generate",
    "db:dev": "npm run db:apply && npm run db:migrate",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "db:recreate": "rm -rf prisma/migrations && npx prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "next": "^16.1.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "prisma": "^7.1.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
