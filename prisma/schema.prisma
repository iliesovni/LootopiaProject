generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hunt {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  steps       Step[]
}

model Step {
  id        String  @id @default(uuid())
  title     String
  clue      String?
  latitude  Float
  longitude Float
  order     Int
  huntId    String
  hunt      Hunt    @relation(fields: [huntId], references: [id])
}
