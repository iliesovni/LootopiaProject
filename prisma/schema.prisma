generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  PARTNER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ParticipationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ARMarkerType {
  IMAGE
  PATTERN
  MODEL_3D
}

enum HuntMode {
  COMMUNITY
  PARTNER
}

enum HuntStatus {
  DRAFT
  PUBLISHED
}

enum HuntVisibility {
  PUBLIC
  PRIVATE
}

model Hunt {
  id          String     @id @default(uuid())
  title       String
  description String?
  location    String
  difficulty  Difficulty
  isPublic    Boolean    @default(true)

  startLat Float
  startLng Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation("UserHunts", fields: [createdById], references: [id], onDelete: Cascade)

  mode HuntMode @default(COMMUNITY)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  steps          Step[]
  participations Participation[]

  status     HuntStatus     @default(DRAFT)
  visibility HuntVisibility @default(PUBLIC)
  accessCode String? // si PRIVATE
  isDeleted  Boolean        @default(false)
  bannerUrl  String? // partner uniquement
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  username     String   @unique
  role         Role     @default(PLAYER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hunts          Hunt[]          @relation("UserHunts")
  participations Participation[]
  partner        Partner?
  stats          UserStats?
}

model Partner {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hunts Hunt[]
}

model Step {
  id           String @id @default(uuid())
  title        String
  description  String
  latitude     Float
  longitude    Float
  radiusMeters Int
  orderIndex   Int
  pointsReward Int

  arMarkerType ARMarkerType?
  arAssetUrl   String?

  huntId String
  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)

  clues        Clue[]
  stepProgress StepProgress[]

  @@unique([huntId, orderIndex])
}

model Clue {
  id            String @id @default(uuid())
  content       String
  penaltyPoints Int
  orderIndex    Int

  stepId String
  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, orderIndex])
}

model Participation {
  id          String              @id @default(uuid())
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  totalScore  Int                 @default(0)
  status      ParticipationStatus @default(IN_PROGRESS)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  huntId String
  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)

  stepProgress StepProgress[]

  @@unique([userId, huntId])
}

model StepProgress {
  id           String    @id @default(uuid())
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  cluesUsed    Int       @default(0)
  pointsEarned Int       @default(0)

  participationId String
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  stepId String
  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([participationId, stepId])
}

model UserStats {
  userId         String @id
  totalPoints    Int    @default(0)
  huntsCompleted Int    @default(0)
  level          Int    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
